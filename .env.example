# ========== 模型提供商（一键切换） ==========
# 可选值: dashscope（阿里云百炼）/ ollama（本地）
# 切换后需重启服务；若切换 Embedding 提供商，还需重建 ChromaDB 向量,需要删除先前创建的向量并且进行重建向量库
MODEL_PROVIDER=

# ========== DashScope（阿里云百炼） ==========
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding

# ========== Ollama（本地，MODEL_PROVIDER=ollama 时生效） ==========
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=30

# ========== 轻量模型（Plan-and-Execute 混合路由） ==========
# 分类器模型：用于查询复杂度分类（L1规则 + L2 LLM 判断）
# DashScope 默认 qwen3-flash，Ollama 默认 qwen3:0.6b
# 留空则使用对应 provider 的默认轻量模型
CLASSIFIER_MODEL=qwen3.7-flash-2026-07-15
# Plan 模型：用于 Plan-and-Execute 模式的计划生成阶段
# DashScope 默认 qwen3-flash，Ollama 默认 qwen3:0.6b
# 留空则使用对应 provider 的默认轻量模型
PLAN_MODEL=qwen3.7-flash-2026-07-15
# ========== 思考模式开关（qwen3 系列，默认关闭） ==========
# true=开启思考（质量更高，但延迟大幅增加，规划/分类任务实测超时 30s+）
# false=关闭思考（响应更快，默认推荐）
# 主对话模型的思考模式由前端页面"深度思考"开关控制，无需改这里
PLAN_ENABLE_THINKING=false
CLASSIFIER_ENABLE_THINKING=false

# ========== MySQL ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=raglearn

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=
REDIS_PASSWORD=

# ========== JWT ==========
JWT_SECRET=raglearn-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== File Upload ==========
MAX_UPLOAD_SIZE_MB=50
USER_STORAGE_QUOTA_MB=500

# ========== Chat Attachment ==========
# 视觉模型（图片/视频理解）
VISION_MODEL=
OLLAMA_VISION_MODEL=
# 视频理解模式: native=原生视频输入 / frames=抽帧（默认，兼容性最好）
VIDEO_MODE=frames
# 视频抽帧数量
VIDEO_FRAME_COUNT=8
# 图片压缩参数
CHAT_IMAGE_MAX_LONG_EDGE=1568
CHAT_IMAGE_QUALITY=85
# 附件限制
CHAT_IMAGE_MAX_MB=10
CHAT_VIDEO_MAX_MB=50
CHAT_MAX_IMAGES_PER_MSG=6
CHAT_MAX_VIDEOS_PER_MSG=1
# 孤儿附件清理时间（小时）
CHAT_ATTACHMENT_ORPHAN_TTL_HOURS=24

# ========== Chat ==========
REDIS_CHAT_BUFFER_SIZE=10
MAX_CHAT_HISTORY_ROUNDS=20
RAG_ROUTE_THRESHOLD=0.5
# RAG 文档总结开关（true=LLM总结，false=轻量截断，默认 false）
RAG_ENABLE_SUMMARIZE=false

# ========== CORS ==========
CORS_ORIGINS=*

# ========== Logging ==========
# LOG_LEVEL: DEBUG（开发，控制台输出）/ INFO（生产，控制台 + 文件滚动）
# LOG_FORMAT: text（开发，纯文本）/ json（生产，结构化）
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ========== Model Trace（P2-2 成本账单 + P2-5 trace 服务化） ==========
# TRACE_SINK: model_trace 输出通道，逗号分隔（log / db / langfuse）
#   log      - 结构化 JSON 日志行（默认，始终可用）
#   db       - 落库 model_traces 表（成本账单聚合数据源）
#   langfuse - 转发 Langfuse trace 平台（需配置下方 LANGFUSE_* 变量）
TRACE_SINK=log,db
# Langfuse trace 平台（自托管或云端，https://langfuse.com 获取密钥）
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ========== HuggingFace ==========
# 离线模式：阻止从 HuggingFace 在线下载模型（使用本地缓存）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ========== QQ 邮箱 SMTP 配置 ==========
# SMTP_PASSWORD 为 QQ 邮箱授权码（设置 → 账户 → POP3/SMTP 服务 开启后获取），非登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=you_qq_email    # 备注：要使用自己的qq邮箱测试登录和注册发送邮件的功能请在qq邮箱上开通SMTP服务，当然也可以使用其他邮箱服务商的SMTP服务，修改SMTP_HOST、SMTP_PORT、SMTP_USERNAME、SMTP_PASSWORD即可
SMTP_PASSWORD= ***********
SMTP_FROM_NAME=云尚

# ========== PPT 生成（讲解 PPT 工具，设计方案 §8.3） ==========
# 渲染引擎：python_pptx（本地开源，v1 默认）/ aspose_cloud（Phase 3 云端模板渲染）
PPT_ENGINE=python_pptx
# Aspose.Slides Cloud 凭证（Phase 3 才需要；从 https://dashboard.aspose.cloud 获取 App SID/Key）
ASPOSE_CLIENT_ID=
ASPOSE_CLIENT_SECRET=
