# ========== LLM 主备策略 ==========
LLM_STRATEGY=OLLAMA_FIRST        # OLLAMA_FIRST | OLLAMA_ONLY | ALIYUN_ONLY
LLM_FALLBACK_ENABLED=true        # Ollama 不可用时是否自动降级到 DashScope
LLM_CIRCUIT_BREAKER_THRESHOLD=3  # 连续失败 N 次触发熔断
LLM_CIRCUIT_BREAKER_COOLDOWN=60  # 熔断后冷却秒数，到期进入半开试探

# ========== Ollama（本地主） ==========
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:latest         # Chat 模型（主）
OLLAMA_TIMEOUT=30                       # 单次请求超时秒数

# ========== DashScope（云端备） ==========
DASHSCOPE_API_KEY=                      # 阿里云百炼 API Key
DASHSCOPE_CHAT_MODEL=qwen3-max          # Chat 模型（备）
DASHSCOPE_FALLBACK_RATE_LIMIT=5         # Fallback 时收紧为 5 次 / 分钟

# ========== Embedding（固定供应商，不参与主备切换） ==========
EMBED_PROVIDER=OLLAMA                   # OLLAMA | DASHSCOPE  ⚠️ 改这个需要重建 ChromaDB 所有向量！
OLLAMA_EMBED_MODEL=nomic-embed-text     # Ollama Embedding 模型

# ========== MySQL ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=raglearn
MYSQL_PASSWORD=                         # 生产环境使用强密码
MYSQL_DATABASE=raglearn

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=

# ========== JWT ==========
JWT_SECRET=                             # openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== File Upload ==========
MAX_UPLOAD_SIZE_MB=50
USER_STORAGE_QUOTA_MB=500

# ========== Chat ==========
REDIS_CHAT_BUFFER_SIZE=10
MAX_CHAT_HISTORY_ROUNDS=20
RAG_ROUTE_THRESHOLD=0.5           # RAG 路由决策阈值（更换 Embedding 模型后需重新校准）

# ========== CORS ==========
CORS_ORIGINS=*                    # 生产环境改为前端地址白名单，如 https://app.example.com
