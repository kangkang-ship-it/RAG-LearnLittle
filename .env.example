# ========== 模型提供商（一键切换） ==========
# 可选值: dashscope（阿里云百炼）/ ollama（本地）
# 切换后需重启服务；若切换 Embedding 提供商，还需重建 ChromaDB 向量,需要删除先前创建的向量并且进行重建向量库
MODEL_PROVIDER=dashscope

# ========== DashScope（阿里云百炼） ==========
DASHSCOPE_API_KEY=sk-ws-H.EHLIRDE.OdTx.MEQCIHfCVd4Fl0yhLip6T9-0p_jP-D6dSFevSdgx5qQe7vw2AiBng3xWOJY3wv-sG30JkkoU80cXLWGjVYxqXlqYgdZIVA
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding

# ========== Ollama（本地，MODEL_PROVIDER=ollama 时生效） ==========
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:0.6b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT=30

# ========== 轻量模型（Plan-and-Execute 混合路由） ==========
# 分类器模型：用于查询复杂度分类（L1规则 + L2 LLM 判断）
# DashScope 默认 qwen3-flash，Ollama 默认 qwen3:0.6b
# 留空则使用对应 provider 的默认轻量模型
CLASSIFIER_MODEL=qwen3.7-flash-2026-07-15
# Plan 模型：用于 Plan-and-Execute 模式的计划生成阶段
# DashScope 默认 qwen3-flash，Ollama 默认 qwen3:0.6b
# 留空则使用对应 provider 的默认轻量模型
PLAN_MODEL=qwen3.7-flash-2026-07-15

# ========== MySQL ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=raglearn

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=3
REDIS_PASSWORD=

# ========== JWT ==========
JWT_SECRET=raglearn-dev-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== File Upload ==========
MAX_UPLOAD_SIZE_MB=50
USER_STORAGE_QUOTA_MB=500

# ========== Chat ==========
REDIS_CHAT_BUFFER_SIZE=10
MAX_CHAT_HISTORY_ROUNDS=20
RAG_ROUTE_THRESHOLD=0.5
# RAG 文档总结开关（true=LLM总结，false=轻量截断，默认 false）
RAG_ENABLE_SUMMARIZE=false

# ========== CORS ==========
CORS_ORIGINS=*

# ========== Logging ==========
# LOG_LEVEL: DEBUG（开发，控制台输出）/ INFO（生产，控制台 + 文件滚动）
# LOG_FORMAT: text（开发，纯文本）/ json（生产，结构化）
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# ========== HuggingFace ==========
# 离线模式：阻止从 HuggingFace 在线下载模型（使用本地缓存）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
